{
  "rule": "How a client turns the sanitized HTML of a status's content (or the plain text of a content warning or a display name) and its custom emoji into blocks of runs. Blocks: p -> paragraph, blockquote -> quote, pre -> code, each li of ul or ol -> list_item; text outside any block is a paragraph. Inside a block, whitespace collapses to one space and is trimmed at both ends, except in code; br is a newline and the whitespace around it is dropped. A run has text, optional styles (strong for b and strong, emphasis for i and em, strikethrough for del and s, underline for u, code for code; in this order), and an optional link: mention for an a with class mention without hashtag, hashtag for an a with class hashtag, url for any other a. A span with class invisible is dropped; a span with class ellipsis keeps its text and adds an ellipsis after it. ruby keeps its base text and rp and rt text in order. Any other element keeps its text, and any other block element (div, for one) is a paragraph. A :shortcode: of the emoji list becomes an emoji run (same link as its surroundings), any other :word: stays text. Adjacent runs with the same styles and link merge. A paragraph with no runs is dropped.",
  "cases": [
    {
      "name": "plain paragraphs and a line break",
      "format": "html",
      "input": "<p>Hello  world</p><p>line one<br>line two</p>",
      "emojis": [],
      "blocks": [
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "Hello world"
            }
          ]
        },
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "line one\nline two"
            }
          ]
        }
      ]
    },
    {
      "name": "mention, hashtag and a shortened link",
      "format": "html",
      "input": "<p><span class=\"h-card\"><a href=\"https://remote.example/@Carol\" class=\"u-url mention\" rel=\"nofollow noopener noreferrer\" target=\"_blank\">@<span>Carol</span></a></span> see <a href=\"https://my.example/tags/go\" class=\"mention hashtag\" rel=\"tag\">#<span>go</span></a> and <a href=\"https://example.com/a/very/long/path/that/is/shortened\" rel=\"nofollow noopener noreferrer\" target=\"_blank\"><span class=\"invisible\">https://</span><span class=\"ellipsis\">example.com/a/very/long/pat</span><span class=\"invisible\">h/that/is/shortened</span></a></p>",
      "emojis": [],
      "blocks": [
        {
          "type": "paragraph",
          "runs": [
            {
              "text": "@Carol",
              "link": {
                "type": "mention",
                "href": "https://remote.example/@Carol"
              }
            },
            {
              "text": " see "
            },
            {
              "text": "#go",
              "link": {
                "type": "hashtag",
                "href": "https://my.example/tags/go"
              }
            },
            {
              "text": " and "
            },
            {
              "text": "example.com/a/very/long/pat…",
              "link": {
                "type": "url",
                "href": "https://example.com/a/very/long/path/that/is/shortened"
              }
            }
          ]
        }
      ]
    },
